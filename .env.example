# Use a Neon direct URL to enable real PostgreSQL backups.
# Local SQLite is only for quick interface testing.
DATABASE_URL=sqlite:///./backupmanager_local.db
BACKUP_DATABASE_URL=
# Change this local example token. Never publish your .env file.
BACKUP_ADMIN_TOKEN=cambiar-este-token-antes-de-publicar
BACKUP_DIR=./backups
# OPTIONAL: separate PostgreSQL database used only for recovery tests.
RESTORE_DATABASE_URL=
# On Windows, set this if pg_dump is not in PATH:
# PG_BIN_DIR=C:\Program Files\PostgreSQL\17\bin
